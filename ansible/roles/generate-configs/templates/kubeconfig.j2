apiVersion: v1
kind: Config

clusters:
  - name: kubernetes
    cluster:
      server: "{{ item.server }}"
      certificate-authority-data: "{{ lookup('file', pki_dir + '/ca.crt', rstrip=false) | b64encode }}"

users:
  - name: "{{ item.name }}"
    user:
      client-certificate-data: "{{ lookup('file', pki_dir + '/' + item.certificate + '.crt', rstrip=false) | b64encode }}"
      client-key-data: "{{ lookup('file', pki_dir + '/' + item.certificate + '.key', rstrip=false) | b64encode }}"

contexts:
  - name: "{{ item.name }}"
    context:
      cluster: kubernetes
      user: "{{ item.name }}"

current-context: "{{ item.name }}"
